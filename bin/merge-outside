#!/bin/sh
# Merges a pull request the CI name guard skipped: scans it here, then merges exactly what was scanned.
set -eu
number="$1"
cd "$(dirname "$0")/.."
git fetch -q origin main
git fetch -q origin "pull/${number}/head"
head="$(git rev-parse FETCH_HEAD)"
title="$(gh pr view "${number}" --json title --jq .title)"
body="$(gh pr view "${number}" --json body --jq .body)"
GUARD_TEXT_TITLE="${title}" GUARD_TEXT_BODY="${body}" python3 -I tools/name_guard.py range origin/main "${head}"
# The title and body are passed back so an edit made after the scan cannot reach main.
gh pr merge "${number}" --squash --match-head-commit "${head}" --subject "${title} (#${number})" --body "${body}"
