#!/bin/sh
# Everything the check workflow runs.
set -eu
cd "$(dirname "$0")/.."
# Without rustup nothing applies rust-toolchain.toml, so a newer local Rust would pass here and fail in CI.
# rustfmt and clippy must come from the same release as rustc; only rustc is checked.
want="$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)"
have="$(rustc --version | cut -d' ' -f2)"
if [ "${have}" != "${want}" ]; then
  echo "bin/check: rustc is ${have}, rust-toolchain.toml pins ${want}" >&2
  exit 1
fi
cargo fmt --check
cargo clippy --locked --all-targets -- -D warnings
if [ "${BLACKHOLE_SHARED_CPU+x}" = x ]; then
  echo "bin/check: timing tests left to local and CI runs"
  set -- --lib --bins
  for file in tests/*.rs; do
    target=${file##*/}
    target=${target%.rs}
    if [ "${target}" != resolution_time ]; then
      set -- "$@" --test "${target}"
    fi
  done
  cargo test --locked "$@"
  cargo test --locked --doc
else
  cargo test --locked
fi
python3 -I -m unittest discover -s tools
cargo run --locked --quiet -- check
