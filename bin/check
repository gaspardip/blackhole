#!/bin/sh
# Everything the check workflow runs.
set -eu
cd "$(dirname "$0")/.."
# Without rustup nothing applies rust-toolchain.toml, so a newer local Rust would pass here and fail in CI.
# rustfmt and clippy must come from the same release as rustc; only rustc is checked.
want="$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)"
have="$(rustc --version | cut -d' ' -f2)"
if [ "${have}" != "${want}" ]; then
  echo "bin/check: rustc is ${have}, rust-toolchain.toml pins ${want}" >&2
  exit 1
fi
cargo fmt --check
cargo clippy --locked --all-targets -- -D warnings
if [ "${BLACKHOLE_SHARED_CPU:-}" = 1 ] && [ "${GITHUB_ACTIONS:-}" != true ]; then
  echo "bin/check: timing tests left to local and CI runs"
  python3 -I -c '
import json
import os
import subprocess
import sys

metadata = json.loads(subprocess.check_output(
    ["cargo", "metadata", "--no-deps", "--format-version", "1", "--locked"]
))
test_targets = [
    target["name"]
    for package in metadata["packages"]
    for target in package["targets"]
    if "test" in target["kind"] and target["name"] != "resolution_time"
]
if not test_targets:
    sys.exit("bin/check: no integration test targets selected")

command = ["cargo", "test", "--locked", "--lib", "--bins"]
for target in test_targets:
    command.extend(["--test", target])
os.execvp(command[0], command)
'
  cargo test --locked --doc
else
  cargo test --locked
fi
python3 -I -m unittest discover -s tools
cargo run --locked --quiet -- check
